<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        El color de la barra de estado es el turquesa de la cabecera de la
        app web, y el de la barra de navegación, el papel crema del fondo.
        Los valores están duplicados con los del HTML por necesidad: el
        sistema no puede leer las variables CSS. Si cambia la paleta de
        patwalink.html, hay que cambiarlos aquí.
    -->
    <style name="Tema" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/barra_estado</item>
        <item name="android:navigationBarColor">@color/barra_navegacion</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/fondo_ventana</item>
    </style>
</resources>
