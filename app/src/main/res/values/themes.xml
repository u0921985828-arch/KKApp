<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema claro, sin variante nocturna, a juego con la app web.

        El parent es Light y no DayNight a propósito: PatwaLink es un cartel
        serigrafiado con una paleta fija —papel crema, tinta casi negra,
        turquesa de cabecera— y no existe una versión oscura de ese diseño.
        Un tema DayNight oscurecería el marco del sistema alrededor de una
        página que sigue siendo clara, y el resultado sería una franja negra
        pegada a un cartel de color.

        Los colores están duplicados con los del HTML por necesidad: el
        sistema no puede leer variables CSS. Si cambia la paleta de
        patwalink.html, hay que cambiarlos aquí.
    -->
    <style name="Tema" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/barra_estado</item>
        <item name="android:navigationBarColor">@color/barra_navegacion</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/fondo_ventana</item>
    </style>
</resources>
