{
  "name": "cerca",
  "version": "0.3.0",
  "private": true,
  "description": "CERCA · localizador de baños públicos",
  "scripts": {
    "check": "sed -n '/<script>/,/<\\/script>/p' www/index.html | sed '1d;$d' > /tmp/app.js && node --check /tmp/app.js",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "serve": "npx --yes serve www"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/geolocation": "^6.0.1"
  }
}
